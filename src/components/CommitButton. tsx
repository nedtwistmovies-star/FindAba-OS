type Props = {
  roomId: string;
  checkIn: string;
  checkOut: string;
  disabled?: boolean;
};

export default function CommitButton({
  roomId,
  checkIn,
  checkOut,
  disabled,
}: Props) {
  const { bookAndPay, loading } = useBookingFlow();

  const handleClick = async () => {
    try {
      await bookAndPay({
        roomId,
        checkIn,
        checkOut,
      });

      alert('Booking Confirmed ✅');
    } catch (e) {
      alert('Failed ❌');
    }
  };

  return (
    <button
      onClick={handleClick}
      disabled={loading || disabled}
      className="w-full bg-green-900 text-white py-4 rounded-xl disabled:opacity-50"
    >
      {loading ? 'Processing...' : 'COMMIT BOOKING'}
    </button>
  );
}
