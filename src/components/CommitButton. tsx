// src/components/CommitButton.tsx
import { useBookingFlow } from '../hooks/useBooking';

type Props = {
  roomId: string;
  checkIn: string;
  checkOut: string;
};

export default function CommitButton({ roomId, checkIn, checkOut }: Props) {
  const { bookAndPay, loading } = useBookingFlow();

  const handleClick = async () => {
    try {
      // Basic validation (IMPORTANT)
      if (!checkIn || !checkOut) {
        alert('Please select dates');
        return;
      }

      await bookAndPay({
        roomId,
        checkIn,
        checkOut,
      });

      alert('Booking Confirmed ✅');
    } catch (e) {
      console.error(e);
      alert('Failed ❌');
    }
  };

  return (
    <button
      onClick={handleClick}
      disabled={loading}
      className="w-full bg-green-900 text-white py-4 rounded-xl"
    >
      {loading ? 'Processing...' : 'COMMIT BOOKING'}
    </button>
  );
}
