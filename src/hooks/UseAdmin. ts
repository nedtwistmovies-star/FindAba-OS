import { supabase } from "../lib/supabase";

export async function requireAdmin() {
  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) return false;

  const { data } = await supabase
    .from("profiles")
    .select("role")
    .eq("auth_id", user.id)
    .single();

  return data?.role === "admin";
}
