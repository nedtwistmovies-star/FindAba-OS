# Build output — Vite content-hashes filenames on every build,
# so committing this causes stale-file races during deployment
# (Vercel restoring old hashed asset names that vite's build then deletes).
dist/
dist-ssr/

# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
.vscode/
.idea/

# Vercel
.vercel/
